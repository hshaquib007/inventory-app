# Copy this file to .streamlit/secrets.toml and fill in your Turso credentials.
# NEVER commit the real secrets.toml to GitHub.
#
# 1) Create a free Turso database at https://turso.tech
# 2) Run:  turso db create inventory
#    Then: turso db show inventory   -> copy the URL
#    And:  turso db tokens create inventory -> copy the auth token
#
# On Streamlit Community Cloud, paste these same values into:
#   Streamlit Cloud Dashboard -> App -> Settings -> Secrets

[turso]
database_url = "libsql://YOUR-DATABASE-ORG.turso.io"
auth_token   = "eyJhbGciOiYOUR_TOKEN_HERE"